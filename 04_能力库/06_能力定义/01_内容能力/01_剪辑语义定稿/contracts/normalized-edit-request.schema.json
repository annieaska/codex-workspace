{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-edit-request.v1",
  "title": "NormalizedEditRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "blueprint_version", "video_type", "source_refs", "primary_video_ref", "subtitles", "logic_structure", "units"],
  "properties": {
    "schema_version": {"const": "normalized-edit-request.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "blueprint_version": {"const": "V1"},
    "video_type": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "primary_video_ref": {"type": "string", "minLength": 1},
    "subtitles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subtitle"}},
    "logic_structure": {"type": "string", "minLength": 1},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "subtitle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "text", "source_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1}, "text": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "element": {
      "type": "object", "additionalProperties": false, "required": ["type", "label"],
      "properties": {"type": {"enum": ["person", "product", "number", "comparison", "cause", "step", "scene", "label"]}, "label": {"type": "string", "minLength": 1}}
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["id", "variant", "labels"],
      "properties": {"id": {"type": "string", "pattern": "^COMP-[0-9]{2}$"}, "variant": {"type": "string", "minLength": 1}, "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["description", "rationale", "elements", "component"],
      "properties": {
        "description": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
        "acquisition_hint": {"type": "string"}, "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "component": {"$ref": "#/$defs/component"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "title", "logic_role", "subtitle_ids", "visual_methods", "transition", "scenes"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1}, "logic_role": {"type": "string", "minLength": 1},
        "subtitle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visual_methods": {"type": "array", "minItems": 1, "items": {"enum": ["talking_head", "b_roll", "information_component"]}},
        "transition": {"type": "object", "additionalProperties": false, "required": ["from_previous", "to_next"], "properties": {"from_previous": {"type": "string", "minLength": 1}, "to_next": {"type": "string", "minLength": 1}}},
        "scenes": {"type": "object", "additionalProperties": false, "required": ["start", "middle", "end"], "properties": {"start": {"$ref": "#/$defs/scene"}, "middle": {"$ref": "#/$defs/scene"}, "end": {"$ref": "#/$defs/scene"}}}
      }
    }
  }
}
