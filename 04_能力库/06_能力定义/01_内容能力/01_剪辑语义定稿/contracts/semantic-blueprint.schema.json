{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-blueprint.v1",
  "title": "SemanticBlueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blueprint_id", "blueprint_version", "created_at", "producer", "source_request_ref", "source_refs", "primary_video_ref", "video_type", "logic_structure", "component_catalog_ref", "units", "continuity_checks", "derivative_policy", "content_hash"],
  "properties": {
    "schema_version": {"const": "semantic-blueprint.v1"},
    "blueprint_id": {"type": "string", "minLength": 1},
    "blueprint_version": {"const": "V1"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "video.semantic_blueprint.finalize"},
    "source_request_ref": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "primary_video_ref": {"type": "string", "minLength": 1},
    "video_type": {"type": "string", "minLength": 1},
    "logic_structure": {"type": "string", "minLength": 1},
    "component_catalog_ref": {
      "type": "object", "additionalProperties": false, "required": ["catalog_id", "version", "sha256"],
      "properties": {"catalog_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
    },
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "continuity_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/continuity_check"}},
    "derivative_policy": {"type": "object", "additionalProperties": false, "required": ["semantic_source_of_truth", "derived_artifacts_may_overwrite_blueprint"], "properties": {"semantic_source_of_truth": {"const": "SemanticBlueprint"}, "derived_artifacts_may_overwrite_blueprint": {"const": false}}},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "element": {
      "type": "object", "additionalProperties": false, "required": ["type", "label"],
      "properties": {"type": {"enum": ["person", "product", "number", "comparison", "cause", "step", "scene", "label"]}, "label": {"type": "string", "minLength": 1}}
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "variant", "labels", "name", "action", "must_change"],
      "properties": {
        "id": {"type": "string", "pattern": "^COMP-[0-9]{2}$"}, "variant": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "name": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "must_change": {"type": "string", "minLength": 1}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "rationale", "elements", "component"],
      "properties": {
        "description": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1},
        "acquisition_hint": {"type": "string"}, "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
        "component": {"$ref": "#/$defs/component"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["from_previous", "to_next"],
      "properties": {"from_previous": {"type": "string", "minLength": 1}, "to_next": {"type": "string", "minLength": 1}}
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "title", "logic_role", "subtitle_ids", "visual_methods", "transition", "scenes", "subtitle", "time_range_ms", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1}, "logic_role": {"type": "string", "minLength": 1},
        "subtitle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visual_methods": {"type": "array", "minItems": 1, "items": {"enum": ["talking_head", "b_roll", "information_component"]}},
        "transition": {"$ref": "#/$defs/transition"},
        "scenes": {"type": "object", "additionalProperties": false, "required": ["start", "middle", "end"], "properties": {"start": {"$ref": "#/$defs/scene"}, "middle": {"$ref": "#/$defs/scene"}, "end": {"$ref": "#/$defs/scene"}}},
        "subtitle": {"type": "string", "minLength": 1},
        "time_range_ms": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "items": false},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "continuity_check": {
      "type": "object", "additionalProperties": false, "required": ["unit_id", "from_previous", "to_next", "status"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1}, "from_previous": {"type": "string", "minLength": 1},
        "to_next": {"type": "string", "minLength": 1}, "status": {"const": "declared"}
      }
    }
  }
}
